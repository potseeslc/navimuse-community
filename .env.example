NAVIDROME_USERNAME=your_navidrome_username
NAVIDROME_PASSWORD=
PUBLIC_NAVIDROME_URL=http://your-navidrome-host:4533
NAVIMUSE_ALLOWED_NAVIDROME_HOSTS=navidrome:4533
AUDIOMUSE_API_TOKEN=
# Direct AUDIOMUSE_API_TOKEN takes precedence. File-backed deployments must include
# deploy/docker-compose.audiomuse-secret.yml and create AUDIOMUSE_API_TOKEN_HOST_FILE first.
# /run/secrets/audiomuse_api_token is a Docker-only path; missing optional files are ignored locally.
AUDIOMUSE_API_TOKEN_FILE=/run/secrets/audiomuse_api_token
AUDIOMUSE_API_TOKEN_HOST_FILE=./secrets/audiomuse_api_token
PUBLIC_AUDIOMUSE_URL=http://your-audiomuse-host:8000
NAVIMUSE_ALLOWED_AUDIOMUSE_HOSTS=audiomuse-ai-flask-app:8000
NAVIMUSE_BUILD_CONTEXT=/path/to/navimuse/repo
NAVIMUSE_OIDC_ISSUER=https://id.example.com
NAVIMUSE_OIDC_CLIENT_ID=your-pocket-id-client-id
NAVIMUSE_OIDC_REDIRECT_URI=https://navimuse.example.com/api/auth/callback
NAVIMUSE_OIDC_CLIENT_SECRET_HOST_FILE=./secrets/navimuse_oidc_client_secret
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
TRUST_PROXY=false
